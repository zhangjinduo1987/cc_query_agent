# BI Chat 智能问数服务
# 环境变量配置，复制此文件为 .env 并填写真实值

# ── MySQL 元数据库（存储 olap_table_pro / olap_src_table_field_mapping / olap_table_plus）──
METADATA_DB_URL=mysql+pymysql://user:password@localhost:3306/descartes

# ── BI 数据查询库（实际执行问数 SQL 的数据库，可多数据源，此为默认）──
BI_DB_URL=mysql+pymysql://user:password@localhost:3306/bi_data

# ── Anthropic API Key（意图识别用轻量模型）──
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── 服务配置 ──
HOST=0.0.0.0
PORT=8100
DEBUG=false

# ── CC Agent 配置 ──
CC_MAX_TURNS=20
CC_WORKSPACE_ROOT=./cc_workspace
